{
  "name": "mehyarmedia-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mehyar Media CRM command center foundation.",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "compliance:demo": "node src/compliance/gates.js",
    "segments:demo": "node src/segments/builder.js",
    "spg:trends:fetch": "node scripts/fetch-google-trends.mjs data/google-trends-snapshot.json",
    "spg:trends:update": "node scripts/update-trend-offers.mjs data/google-trends-snapshot.json src/spg/trending-offers.js",
    "spg:static:build": "node scripts/generate-spg-static.js",
    "spg:trends:build": "npm run spg:static:build && node scripts/build-spg-trend-pages.mjs",
    "spg:trends:daily": "npm run spg:daily",
    "spg:rss:fetch": "node scripts/fetch-spg-rss.mjs data/spg-rss-source-registry.json data/spg-rss-snapshot.json",
    "spg:rss:update": "node scripts/update-spg-rss-candidates.mjs data/spg-rss-snapshot.json data/spg-rss-candidates.json",
    "spg:offers:fetch": "node scripts/fetch-spg-daily-offers.mjs",
    "spg:ingest:durable": "node scripts/run-spg-durable-ingestion.mjs",
    "spg:ingest:daily": "npm run spg:trends:fetch && npm run spg:trends:update && npm run spg:rss:fetch && npm run spg:rss:update && npm run spg:offers:fetch && SPG_ENABLE_RUNTIME_CREDENTIAL_STATE=1 SPG_DAILY_OFFER_FEED_PATH=data/spg-daily-offer-feed.json SPG_MAX_ITEMS_PER_SOURCE=120 npm run spg:ingest:durable",
    "spg:qa:offers": "node scripts/qa-spg-offers.mjs",
    "opportunities:collect": "node scripts/collect-opportunity-finder.mjs data/opportunity-source-registry.json data/opportunity-desk/opportunity-source-runs.json data/opportunity-desk/opportunities.json",
    "spg:smoke": "node scripts/smoke-spg-routes.mjs",
    "spg:daily": "npm run spg:ingest:daily && npm run spg:trends:build && npm run spg:qa:offers && npm test",
    "spg:deploy:gate": "npm run spg:daily && npm run spg:smoke",
    "daily:pull:everything": "bash scripts/daily-pull-everything.sh",
    "spg:live:smoke:strict": "node scripts/strict-live-spg-smoke.mjs",
    "spg:deploy:hostinger": "bash scripts/deploy-spg-hostinger.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
